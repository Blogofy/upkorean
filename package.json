{
  "name": "upkorean",
  "version": "1.0.0",
  "private": true,
  "description": "UpKorean — koreys tili so'z boyligi ilovasi (API + mobil)",
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning apps/api/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch apps/api/index.js --dev",
    "check:content": "node scripts/validate-content.js",
    "plan:vocab": "python scripts/plan-vocab.py",
    "build:course": "node scripts/build-course.mjs",
    "backup": "node --no-warnings=ExperimentalWarning scripts/backup-db.js",
    "test": "node --no-warnings=ExperimentalWarning --test --test-reporter=spec \"test/**/*.test.js\"",
    "mobile": "npm --prefix apps/mobile run start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.10"
  }
}
