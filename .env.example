# Copy to .env and fill in what you need.
PORT=3000
# Public URL of the app (used in password-reset links)
APP_URL=http://localhost:3000

# AI Tutor — Claude API key (https://console.anthropic.com). Without it the tutor runs in offline mode.
ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-opus-5

# Google sign-in — OAuth 2.0 Web client ID (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Demo account button on the login page (default: on only with `npm run dev`, off with `npm start`)
# `npm run dev` also shows the password-reset link in the browser, but only for requests from this machine.
# DEMO=1
# NODE_ENV=production
# Set when running behind a reverse proxy — nginx, Caddy, Cloudflare (e.g. 1). Without it rate limits
# treat every visitor as the same IP address.
# TRUST_PROXY=
# DATA_DIR=data

# Email for password-reset links (any SMTP provider). REQUIRED with NODE_ENV=production: the server refuses to
# start without SMTP_HOST, because a reset link that cannot be emailed can only be a link nobody can use.
# Without it (dev) no reset token is created at all; `npm run dev` still shows the link in the local browser.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="UpKorean <you@gmail.com>"

# Push reminders (Web Push). Keys are generated once into DATA_DIR/vapid.json — keep that file (backups copy it):
# with new keys every browser has to turn reminders on again. Set VAPID_SUBJECT to a real contact in production.
# VAPID_SUBJECT=mailto:you@gmail.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Database backups into DATA_DIR/backups (default: every 24 hours, keep 14; BACKUP_HOURS=0 turns it off).
# Also copy that folder to another disk or cloud storage — a backup on the same disk dies with the disk.
# BACKUP_HOURS=24
# BACKUP_KEEP=14
