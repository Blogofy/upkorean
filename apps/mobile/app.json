{
  "expo": {
    "name": "UpKorean",
    "slug": "upkorean",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "upkorean",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "uz.upkorean.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "uz.upkorean.app",
      "supportsTablet": true
    },
    "extra": {
      "apiUrl": "https://upkorean.uz"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#1B6F65"
        }
      ],
      "expo-asset"
    ]
  }
}
